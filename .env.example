# Copie para .env (cp .env.example .env). O .env fica fora do Git.

# ─── Ambiente-alvo ────────────────────────────────────────────────────────────
# local       → http://localhost:3000 + http://localhost:3333/api/v1 (padrão)
# production  → https://kabins.com.br (dados reais — exige as credenciais abaixo)
# URLs e padrões de cada perfil: src/support/core/environments.ts
E2E_ENV=local

# ─── Credenciais do admin por ambiente ────────────────────────────────────────
# Local: padrão é o admin do seed da cabanas-api (admin@cabanas.local).
# Produção: obrigatórias. Use um admin dedicado à automação.
# E2E_PRODUCTION_ADMIN_EMAIL=
# E2E_PRODUCTION_ADMIN_PASSWORD=

# ─── Sobrescritas opcionais ───────────────────────────────────────────────────
# Valem para qualquer ambiente e têm prioridade sobre o perfil
# (o CI usa isto para apontar para staging).
# E2E_BASE_URL=
# E2E_API_URL=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=

# Domínio dos e-mails das contas criadas pela suíte (facilita identificar/limpar).
# E2E_EMAIL_DOMAIN=e2e.kabins.test

# ─── Execução ─────────────────────────────────────────────────────────────────
# Workers em paralelo (padrão: metade dos núcleos localmente, 2 no CI, 1 em produção).
# Contra o servidor de desenvolvimento do Next, use 4: com mais, o painel esgota o tempo de navegação.
# E2E_WORKERS=4
# Inclui Firefox e WebKit além do Chromium.
# E2E_ALL_BROWSERS=true
# Usa um navegador já instalado em vez do Chromium baixado pelo Playwright
# (útil quando políticas da máquina bloqueiam binários recém-baixados).
# E2E_BROWSER_CHANNEL=msedge
